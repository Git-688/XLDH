# ===== 全局安全头 =====
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; style-src 'self' 'unsafe-inline' https: data:; img-src * data: blob:; media-src * https:; connect-src *; font-src 'self' https: data:; frame-src 'self' https:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests

# ===== 首页不缓存 =====
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ===== Service Worker 必须不缓存（关键） =====
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Service-Worker-Allowed: /

# ===== 后台管理页面不缓存 =====
/admin.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ===== 静态资源缓存策略 =====
# 图片等媒体资源（强缓存 1 年，不可变）
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.gif
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.ico
  Cache-Control: public, max-age=31536000, immutable

# CSS 文件（带 ?v= 版本号，可强缓存）
/css/*.css
  Cache-Control: public, max-age=31536000, immutable
/css/**/*.css
  Cache-Control: public, max-age=31536000, immutable

# JS 文件（带 ?v= 版本号，可强缓存）
/js/*.js
  Cache-Control: public, max-age=31536000, immutable
/js/**/*.js
  Cache-Control: public, max-age=31536000, immutable

# 数据文件（本地音乐等）
/data/*.js
  Cache-Control: public, max-age=86400

# 工具页面（较短缓存，便于更新）
/pages/**
  Cache-Control: public, max-age=3600

# Sitemap 和 Robots
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml

/robots.txt
  Cache-Control: public, max-age=86400

# 字体文件
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *